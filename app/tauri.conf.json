{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cartographer",
  "version": "2.0.0",
  "identifier": "com.cosmicceo.cartographer",
  "build": { "frontendDist": "start" },
  "app": {
    "windows": [{ "label": "main", "title": "Cartographer", "width": 460, "height": 900, "minWidth": 380, "minHeight": 500 }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"]
  }
}
